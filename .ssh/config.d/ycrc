# Yale YCRC clusters. Managed by dotfiles/update.sh - local edits are overwritten.
#
# ControlMaster shares one authenticated connection. The first ssh becomes the
# master and publishes a socket; later ssh/scp/rsync to the same host reuse it
# and skip Duo entirely. Persists 8h after the last client exits.
#
# After a network change the socket can go stale and new connections hang.
# Drop it with:  ssh -O exit bouchet.ycrc.yale.edu

# Leading wildcards so specific login nodes (login2.mccleary...) multiplex too,
# not just the round-robin names.
Host *bouchet.ycrc.yale.edu *mccleary.ycrc.yale.edu
  User mcn26
  ControlMaster auto
  ControlPath ~/.ssh/cm/%r@%h:%p
  ControlPersist 8h
